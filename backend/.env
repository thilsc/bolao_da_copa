# Variáveis de Ambiente do Backend

# Secret key para JWT (mínimo 32 caracteres)
JWT_SECRET=supersecretkey2024bolaocopa2026securetoken

# Nome do banco de dados SQLite
DATABASE_NAME=bolao.db

# Porta do servidor (opcional, padrão é 5000)
PORT=5000

# URL da aplicação (opcional - usado para links de verificação de email)
# APP_URL=https://seu-dominio.com

# Chave da API de futebol (opcional - para sincronização automática de partidas)
# FOOTBALL_DATA_API_KEY=sua_chave_aqui

# Configurações de SMTP para envio de emails (opcionais)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua-senha-de-app
# SMTP_FROM=Bolão Copa 2026 <seu-email@gmail.com>

# Credenciais do administrador
ADMIN_USERNAME=admin@bolao.com
ADMIN_PASSWORD=Admin@123456
